# =========================================================================
# fae-api — Plantilla de variables de entorno
# =========================================================================
# Copiar a `.env` (local) o `.env.prod` (producción) y rellenar.
# =========================================================================

# --- PostgreSQL (en red `fae-data` o Neon Cloud en prod) -----------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=faceattend_db
DB_SSLMODE=require
DB_CHANNEL_BINDING=require
HIKARI_MAX_POOL=3
HIKARI_MIN_IDLE=0
NODE_DB_POOL_MAX=3

IDENTITY_SERVICE_PASSWORD=
AUTHORIZATION_SERVICE_PASSWORD=
ACADEMIC_SERVICE_PASSWORD=
SCHEDULING_SERVICE_PASSWORD=
ATTENDANCE_SERVICE_PASSWORD=
BIOMETRIC_SERVICE_PASSWORD=
CONFIGURATION_SERVICE_PASSWORD=
NOTIFICATION_SERVICE_PASSWORD=

# --- MongoDB (en `fae-data`) ---------------------------------------
MONGO_HOST=mongodb
MONGO_ROOT_USER=faceattend_mongo
MONGO_ROOT_PASSWORD=
MONGO_DB=faceattend_biometric

# --- MinIO (en `fae-data`) -----------------------------------------
MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_ROOT_USER=faceattend_minio
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=attendance-documents
GUARDIAN_STORAGE_BUCKET=guardian-documents

# --- Redis (en `fae-data`) -----------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=

# --- Criptografía de aplicación -------------------------------------------
FACEATTEND_DOCUMENT_PEPPER=
BIOMETRIC_EMBEDDING_ENCRYPTION_KEY=
ONBOARDING_SERVICE_USER_ID=
FACEATTEND_SESSION_COOKIE_SECURE=true
FACEATTEND_AUTH_CONFIGURATION_URL=http://ms-configuration:8087

# --- 08-ms-notification: evaluador y SMTP ---------------------------------
NOTIFICATION_SERVICE_USERNAME=
NOTIFICATION_SERVICE_AUTH_PASSWORD=
NOTIFICATION_EVAL_INTERVAL_MS=300000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FaceAttend EDU <no-reply@faceattend.edu>"
EMAIL_INTERNAL_TOKEN=

# --- Kong CORS y Rate Limit -----------------------------------------------
KONG_CORS_ORIGINS=http://localhost:8080,http://localhost:8090,http://localhost:19006,http://localhost:3000
KONG_RATE_LIMIT_PER_MINUTE=300

# --- TLS / Producción (docker-compose.prod.yml) ---------------------------
API_DOMAIN=
ACME_EMAIL=
